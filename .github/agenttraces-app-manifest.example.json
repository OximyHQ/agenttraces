{
  "name": "AgentTraces",
  "description": "Connect coding-agent traces to the pull requests that produced them.",
  "url": "https://agenttraces.sh",
  "hook_attributes": {
    "url": "https://api.agenttraces.sh/v1/github/webhooks",
    "active": true
  },
  "redirect_url": "https://agenttraces.sh/dashboard/team",
  "callback_urls": [
    "https://agenttraces.sh/api/auth/callback/github"
  ],
  "setup_url": "https://agenttraces.sh/dashboard/team",
  "setup_on_update": true,
  "public": true,
  "default_permissions": {
    "contents": "read",
    "metadata": "read",
    "pull_requests": "read"
  },
  "default_events": [
    "installation",
    "installation_repositories",
    "pull_request",
    "push"
  ]
}
